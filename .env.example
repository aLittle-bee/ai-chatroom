# Copy to .env and fill in. The app works with any subset of providers —
# a missing key just makes that provider unavailable in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Get one at https://openrouter.ai/keys — unlocks Llama/DeepSeek/Grok/Mistral/etc.
OPENROUTER_API_KEY=
# Your name as it appears in the room (models see your messages as "[Name]: …")
HOST_NAME=Host
PORT=5057
